# Python helper scripts and the flux module are installed by automake
# directly (no distutils/setuptools needed, which keeps the build working
# with Python >= 3.12 where distutils has been removed).

dist_bin_SCRIPTS = fmlstats ftbl2fml sbml2fml fml2sbml \
		   setparameters setmeasurements setinputs \
		   multiply_fml fmlupdate

python_PYTHON = flux.py

EXTRA_DIST = setup.py
